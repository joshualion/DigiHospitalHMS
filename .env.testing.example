APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Preferred for full parity once a dedicated database is available:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hms_testing
# DB_USERNAME=
# DB_PASSWORD=

# Phase 0 isolated fallback, compatible with current non-domain migrations:
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
